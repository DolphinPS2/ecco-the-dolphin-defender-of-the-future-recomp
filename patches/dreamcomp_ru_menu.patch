 #include <cstring>
 #include <fstream>
 #include <sstream>
+#include <unordered_map>
+
+namespace {
+std::string tr_lookup(const std::string& text, const std::filesystem::path* init_dir = nullptr) {
+    static bool loaded = false;
+    static bool enabled = false;
+    static std::unordered_map<std::string, std::string> dict;
+    if (init_dir && !loaded) {
+        loaded = true;
+        const char* lang = std::getenv("DREAMCOMP_LANG");
+        const char* appd = std::getenv("APPDATA"); if ((lang && std::string(lang) == "ru") || (appd && std::string(appd).find("paradox_rus") != std::string::npos)) {
+            enabled = true;
+            std::ifstream in(*init_dir / "frontend" / "lang_ru.ini", std::ios::binary);
+            std::string line;
+            bool first = true;
+            while (std::getline(in, line)) {
+                if (first && line.size() >= 3 && (unsigned char)line[0] == 0xEF && (unsigned char)line[1] == 0xBB && (unsigned char)line[2] == 0xBF)
+                    line.erase(0, 3);
+                first = false;
+                if (!line.empty() && line.back() == '\r') line.pop_back();
+                auto eq = line.find('=');
+                if (eq != std::string::npos && eq > 0)
+                    dict[line.substr(0, eq)] = line.substr(eq + 1);
+            }
+        }
+    }
+    if (!enabled || text.empty()) return text;
+    auto it = dict.find(text);
+    return it != dict.end() ? it->second : text;
+}
+} // namespace
